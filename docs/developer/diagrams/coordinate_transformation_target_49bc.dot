digraph coordinate_target_49bc {
  graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=15,
    label="Wenu coordinates after 49B/49C — one common geometry contract",
    labelloc="t", nodesep=0.38, ranksep=0.55, pad=0.25];
  node [shape=box, style="rounded,filled", fillcolor="#f7f7f7", color="#555555", fontname="Helvetica", fontsize=9.5];
  edge [color="#555555", fontname="Helvetica", fontsize=8, arrowsize=0.7];
  sources [label="Existing sources\nstars / DSO / grids / reference points", fillcolor="#e4dfec"];
  moving [label="Moon / planet PositionProvider (later)\nnew source; same output contract", fillcolor="#fff2cc", style="rounded,dashed,filled"];
  geometry [label="SphericalPoints / Curves / Polygons / Grid\ncarrying immutable CoordinateSpec", fillcolor="#e2f0d9"];
  target [label="Target CoordinateSpec\ndeclared by chart/product", fillcolor="#d9eaf7"];
  observation [label="ObservationContext (optional)\nonly for observer-local transformations", fillcolor="#fff2cc"];
  service [label="CoordinateService.transform()\nsole astronomical transformation owner\nAstropy-backed; preserves kind and topology", fillcolor="#e2f0d9", color="#548235"];
  resolved [label="Same Spherical* kind\ncarrying resolved CoordinateSpec", fillcolor="#e2f0d9"];
  downstream [label="SphericalFrame alignment -> projection -> clipping\n-> preparation -> renderer -> export\nunchanged and coordinate-neutral", fillcolor="#d9eaf7"];
  sources -> geometry; moving -> geometry [label="same contract"];
  geometry -> service [label="source spec travels with geometry"];
  target -> service; observation -> service [style=dashed, label="when required"];
  service -> resolved -> downstream;
  invariant [shape=note, fillcolor="#ffffff", label="Future Moon/planet support adds only a PositionProvider.\nNo CoordinateService, geometry, projection, or renderer modification is required."];
  moving -> invariant [style=dotted, arrowhead=none];
}
