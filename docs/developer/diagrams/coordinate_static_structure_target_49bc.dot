digraph coordinate_static_target {
  graph [rankdir=LR, bgcolor="white", fontname="Helvetica", fontsize=15,
    label="Wenu coordinate static structure after 49B/49C — proposed types and placement",
    labelloc="t", nodesep=0.35, ranksep=0.6, pad=0.25];
  node [shape=record, style="filled", fillcolor="#f7f7f7", color="#555555",
    fontname="Helvetica", fontsize=8.5];
  edge [color="#555555", fontname="Helvetica", fontsize=7.5, arrowsize=0.7];

  subgraph cluster_state {
    label="PROPOSED src/wenu/astronomy/state.py — 49B immutable vocabulary";
    color="#548235"; style="rounded,dashed";
    FrameSpec [label="{FrameSpec «frozen dataclass»|frame name; origin; equinox/epoch policy}", fillcolor="#e2f0d9"];
    ObservationContext [label="{ObservationContext «frozen dataclass»|instant; time scale; Earth location; atmosphere policy}", fillcolor="#e2f0d9"];
    PositionPolicy [label="{PositionPolicy «frozen dataclass»|geometric/astrometric/apparent/topocentric; corrections}", fillcolor="#e2f0d9"];
    Provenance [label="{StateProvenance «frozen dataclass»|provider/model; source revision; assumptions}", fillcolor="#e2f0d9"];
    ScientificIdentity [label="{ScientificIdentity «frozen dataclass»|frame: FrameSpec; epoch; units; representation; position policy}", fillcolor="#e2f0d9"];
    AstronomicalState [label="{AstronomicalState «frozen dataclass»|coordinates; identity: ScientificIdentity; provenance: StateProvenance}", fillcolor="#e2f0d9"];
    ProductFrameRequest [label="{ProductFrameRequest «frozen dataclass»|target: FrameSpec; observer_context: optional; requested policy}", fillcolor="#d9eaf7"];
    ScientificIdentity -> FrameSpec [dir=both, arrowtail=diamond, arrowhead=none, label="contains"];
    ScientificIdentity -> PositionPolicy [dir=both, arrowtail=diamond, arrowhead=none, label="contains"];
    AstronomicalState -> ScientificIdentity [dir=both, arrowtail=diamond, arrowhead=none, label="contains"];
    AstronomicalState -> Provenance [dir=both, arrowtail=diamond, arrowhead=none, label="contains"];
    ProductFrameRequest -> FrameSpec [dir=both, arrowtail=diamond, arrowhead=none, label="contains"];
    ProductFrameRequest -> ObservationContext [dir=both, arrowtail=odiamond, arrowhead=none, label="optional"];
  }

  subgraph cluster_service {
    label="PROPOSED src/wenu/astronomy/service.py and adapters.py — 49C";
    color="#548235"; style="rounded,dashed";
    Transformer [label="{AstronomicalTransformer «Protocol»|transform_state(); transform_geometry(); realize_altaz()}", fillcolor="#e2f0d9"];
    Service [label="{CoordinateService|transform(state, request); transform_geometry(geometry, request)}", fillcolor="#e2f0d9"];
    AstropyAdapter [label="{AstropyTransformAdapter|supported frame transformations}", fillcolor="#e2f0d9"];
    SkyfieldAdapter [label="{SkyfieldStateAdapter|explicit apparent/topocentric state adaptation}", fillcolor="#e2f0d9"];
    Service -> Transformer [arrowhead=empty, style=dashed, label="implements"];
    Service -> AstropyAdapter [dir=both, arrowtail=diamond, arrowhead=none, label="owns"];
    Service -> SkyfieldAdapter [dir=both, arrowtail=diamond, arrowhead=none, label="owns"];
  }

  subgraph cluster_existing {
    label="EXISTING OWNERS AFTER MIGRATION";
    color="#5b9bd5";
    Observer [label="{observer.py::Observer|supplies ObservationContext; no transform authority}", fillcolor="#fff2cc"];
    SkyLayer [label="{sky_layer.py::SkyLayer|produces AstronomicalState or typed geometry}", fillcolor="#e4dfec"];
    Geometry [label="{geometry/spherical.py::Spherical*|structure + ScientificIdentity; preserves topology/labels}", fillcolor="#d9eaf7"];
    ProjectionSelection [label="{charts/projection_selection.py::ProjectionSelection|projection identity + ProductFrameRequest}", fillcolor="#d9eaf7"];
    SphericalFrame [label="{geometry/frame.py::SphericalFrame|projection alignment only}", fillcolor="#e2f0d9"];
  }

  Observer -> ObservationContext [style=dashed, label="constructs"];
  SkyLayer -> AstronomicalState [style=dashed, label="produces"];
  ProjectionSelection -> ProductFrameRequest [style=dashed, label="declares"];
  Service -> AstronomicalState [style=dashed, label="consumes/returns"];
  Service -> ProductFrameRequest [style=dashed, label="consumes"];
  Service -> Geometry [style=dashed, label="transforms, preserving structure"];
  Geometry -> ScientificIdentity [dir=both, arrowtail=diamond, arrowhead=none, label="carries"];
  Geometry -> SphericalFrame [style=dashed, label="then aligns for projection"];

  note [shape=note, label="No deep inheritance tree is proposed.\n49B types compose immutable scientific meaning.\n49C service uses protocols/adapters and returns typed state.", fillcolor="#ffffff"];
}

