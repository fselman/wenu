digraph coordinate_static_target {
  graph [rankdir=LR, bgcolor="white", fontname="Helvetica", fontsize=15,
    label="Wenu coordinate static structure after 49B/49C — retained classes, centralized coordinates",
    labelloc="t", nodesep=0.35, ranksep=0.55, pad=0.25];
  node [shape=record, style="filled", fillcolor="#f7f7f7", color="#555555",
    fontname="Helvetica", fontsize=8.5];
  edge [color="#555555", fontname="Helvetica", fontsize=7.5, arrowsize=0.7];

  subgraph cluster_coordinates {
    label="src/wenu/coordinates.py — one transformation owner"; color="#548235";
    CoordinateSpec [label="{CoordinateSpec «frozen dataclass»|frame; origin; epoch/equinox; instant/time scale;\nposition status; units; provenance}", fillcolor="#e2f0d9"];
    ObservationContext [label="{ObservationContext «frozen dataclass»|location; instant; time scale; atmosphere/refraction policy}", fillcolor="#fff2cc"];
    CoordinateService [label="{CoordinateService|transform(geometry, target_spec, observation=None)|Astropy-backed; preserves geometry kind and topology}", fillcolor="#e2f0d9"];
    Observer [label="{observer.py::Observer|location; time|creates ObservationContext; no transform authority}", fillcolor="#fce4d6"];
    Retired [shape=box, label="radec_to_altaz()\nretired or temporary wrapper", fillcolor="#f4cccc"];
    CoordinateService -> CoordinateSpec [dir=both, arrowtail=diamond, arrowhead=none, label="uses"];
    CoordinateService -> ObservationContext [style=dashed, label="optional local context"];
    Observer -> ObservationContext [style=dashed, label="creates"];
    Retired -> CoordinateService [style=dashed, label="delegates during migration"];
  }

  subgraph cluster_layers {
    label="src/wenu/sky/ and src/wenu/objects/ — hierarchy retained"; color="#8064a2";
    SkyLayer [label="{sky_layer.py::SkyLayer «ABC»|spherical_geometry(observer)}"];
    AstronomicalObject [label="astronomical_object.py::AstronomicalObject"];
    GeometricalObject [label="geometrical_object.py::GeometricalObject"];
    Stars [label="{stars.py::Stars|catalogue loading; produces SphericalPoints}"];
    NonStellar [label="{nonstellar.py::NonStellar|catalogue loading; produces Spherical*}"];
    CoordinatesGrid [label="{coordinate_grids.py::CoordinatesGrid «ABC»|native grid definitions; produces SphericalGrid}"];
    AltAzGrid [label="AltAzGrid"];
    EquatorialGrid [label="EquatorialGrid"];
    EclipticGrid [label="EclipticGrid"];
    GalacticGrid [label="GalacticGrid"];
    CelestialPoints [label="{points.py::CelestialPoints|typed point definitions; produces SphericalPoints}"];
    CelestialSphere [label="{celestial_sphere.py::CelestialSphere|layers: tuple[SkyLayer]|add(); draw_chart()}"];
    MovingProvider [label="{Moon / planet PositionProvider «later»|position(instant) -> SphericalPoints + CoordinateSpec|new source only; no downstream modification}", style="rounded,dashed,filled", fillcolor="#fff2cc"];
    AstronomicalObject -> SkyLayer [arrowhead=empty, label="inherits"];
    GeometricalObject -> SkyLayer [arrowhead=empty, label="inherits"];
    Stars -> AstronomicalObject [arrowhead=empty, label="inherits"];
    NonStellar -> AstronomicalObject [arrowhead=empty, label="inherits"];
    CoordinatesGrid -> GeometricalObject [arrowhead=empty, label="inherits"];
    AltAzGrid -> CoordinatesGrid [arrowhead=empty]; EquatorialGrid -> CoordinatesGrid [arrowhead=empty];
    EclipticGrid -> CoordinatesGrid [arrowhead=empty]; GalacticGrid -> CoordinatesGrid [arrowhead=empty];
    CelestialPoints -> GeometricalObject [arrowhead=empty, label="inherits"];
    CelestialSphere -> SkyLayer [dir=both, arrowtail=diamond, arrowhead=none, label="contains 0..*"];
  }

  subgraph cluster_geometry {
    label="src/wenu/geometry/ — records retained; CoordinateSpec added"; color="#70ad47";
    Points [label="{spherical.py::SphericalPoints «dataclass»|lon_deg; lat_deg; ids; labels; metadata; coordinate_spec}", fillcolor="#e2f0d9"];
    Curves [label="{SphericalCurves «dataclass»|coordinate collections; topology; metadata; coordinate_spec}", fillcolor="#e2f0d9"];
    Polygons [label="{SphericalPolygons «dataclass»|rings; topology; metadata; coordinate_spec}", fillcolor="#e2f0d9"];
    Grid [label="{SphericalGrid «dataclass»|curves: mapping[str, SphericalCurves]; coordinate_spec}", fillcolor="#e2f0d9"];
    SphericalCoordinates [label="{frame.py::SphericalCoordinates «frozen dataclass»|lon_deg; lat_deg}", fillcolor="#e2f0d9"];
    SphericalFrame [label="{frame.py::SphericalFrame «frozen dataclass»|projection alignment only|transform(); inverse_transform()}", fillcolor="#e2f0d9"];
    Grid -> Curves [dir=both, arrowtail=diamond, arrowhead=none, label="contains"];
    Points -> CoordinateSpec [style=dashed, label="carries"];
    Curves -> CoordinateSpec [style=dashed, label="carries"];
    Polygons -> CoordinateSpec [style=dashed, label="carries"];
    SphericalFrame -> SphericalCoordinates [style=dashed, label="returns"];
  }

  subgraph cluster_charts {
    label="src/wenu/charts/ — request target coordinates; projection unchanged"; color="#5b9bd5";
    ProjectionSelection [label="{projection_selection.py::ProjectionSelection «frozen dataclass»|name; target_coordinate_spec|build()}", fillcolor="#d9eaf7"];
    coordinate_frames [shape=box, label="coordinate_frames.py\nremoved or delegates to CoordinateService", fillcolor="#fce4d6"];
    Pipeline [shape=box, label="SphericalFrame -> projection -> clipping -> rendering\nunchanged and coordinate-neutral", fillcolor="#d9eaf7"];
  }

  Stars -> Points [style=dashed, label="produces"]; NonStellar -> Points [style=dashed, label="produces"];
  CoordinatesGrid -> Grid [style=dashed, label="produces"]; CelestialPoints -> Points [style=dashed, label="produces"];
  MovingProvider -> Points [style=dashed, label="same contract"];
  Points -> CoordinateService [style=dashed, label="transform same geometry kind"];
  Curves -> CoordinateService [style=dashed]; Polygons -> CoordinateService [style=dashed]; Grid -> CoordinateService [style=dashed];
  ProjectionSelection -> CoordinateSpec [style=dashed, label="declares target"];
  coordinate_frames -> CoordinateService [style=dashed, label="delegates during migration"];
  CoordinateService -> SphericalFrame [style=dashed, label="resolved geometry"];
  ProjectionSelection -> SphericalFrame [style=dashed, label="alignment"];
  SphericalFrame -> Pipeline [style=dashed, label="unchanged"];
}
