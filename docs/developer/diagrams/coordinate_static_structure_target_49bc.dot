digraph coordinate_static_target_detailed {
  graph [rankdir=LR, bgcolor="white", fontname="Helvetica", fontsize=15,
    label="Wenu coordinate static structure after 49B/49C — proposed classes, data, and modules",
    labelloc="t", nodesep=0.30, ranksep=0.48, pad=0.25];
  node [shape=record, style="filled", fillcolor="#f7f7f7", color="#555555",
    fontname="Helvetica", fontsize=8.2];
  edge [color="#555555", fontname="Helvetica", fontsize=7, arrowsize=0.65];

  subgraph cluster_root {
    label="src/wenu/ — changed roles"; color="#c55a11"; style="rounded,dashed";
    Observer [label="{observer.py::Observer|constructs ObservationContext; no transform authority}", fillcolor="#fff2cc"];
    Coordinates [shape=box, label="coordinates.py\nradec_to_altaz() retired or temporary service wrapper", fillcolor="#fce4d6", color="#c55a11"];
    Cache [shape=box, label="sky/observed_cache.py\nscientifically keyed state reuse", fillcolor="#fff2cc"];
  }
  subgraph cluster_layers {
    label="sky/ + objects/ — inheritance retained; transform authority removed";
    color="#7030a0"; style="rounded,dashed";
    SkyLayer [label="{SkyLayer «ABC»|produces typed state or geometry}", fillcolor="#e4dfec"];
    AstronomicalObject [label="AstronomicalObject", fillcolor="#e4dfec"];
    GeometricalObject [label="GeometricalObject", fillcolor="#e4dfec"];
    Stars [label="{Stars|load catalogue; produce native typed state}", fillcolor="#e4dfec"];
    NonStellar [label="{NonStellar|load catalogue; produce native typed state}", fillcolor="#e4dfec"];
    CoordinatesGrid [label="{CoordinatesGrid «ABC»|native definitions; request service transform}", fillcolor="#e4dfec"];
    CelestialPoints [label="{CelestialPoints|typed point definitions; no handwritten transform}", fillcolor="#e4dfec"];
    AltAzGrid [label="AltAzGrid", fillcolor="#e4dfec"];
    EquatorialGrid [label="EquatorialGrid", fillcolor="#e4dfec"];
    EclipticGrid [label="EclipticGrid", fillcolor="#e4dfec"];
    GalacticGrid [label="GalacticGrid", fillcolor="#e4dfec"];
    CelestialSphere [label="{CelestialSphere|contains 0..* SkyLayer; orchestration unchanged}", fillcolor="#e4dfec"];
    AstronomicalObject -> SkyLayer [arrowhead=empty, label="inherits"];
    GeometricalObject -> SkyLayer [arrowhead=empty, label="inherits"];
    Stars -> AstronomicalObject [arrowhead=empty];
    NonStellar -> AstronomicalObject [arrowhead=empty];
    CoordinatesGrid -> GeometricalObject [arrowhead=empty];
    CelestialPoints -> GeometricalObject [arrowhead=empty];
    AltAzGrid -> CoordinatesGrid [arrowhead=empty];
    EquatorialGrid -> CoordinatesGrid [arrowhead=empty];
    EclipticGrid -> CoordinatesGrid [arrowhead=empty];
    GalacticGrid -> CoordinatesGrid [arrowhead=empty];
    CelestialSphere -> SkyLayer [dir=both, arrowtail=diamond, arrowhead=none, label="contains 0..*"];
  }
  subgraph cluster_astronomy {
    label="PROPOSED astronomy/ — new 49B/49C owner";
    color="#548235"; style="rounded,dashed";
    FrameSpec [label="{FrameSpec|frame; origin; epoch/equinox}", fillcolor="#e2f0d9"];
    ObservationContext [label="{ObservationContext|instant; scale; location; atmosphere}", fillcolor="#e2f0d9"];
    ScientificIdentity [label="{ScientificIdentity|FrameSpec; units; representation; PositionPolicy}", fillcolor="#e2f0d9"];
    AstronomicalState [label="{AstronomicalState|coordinates; identity; provenance}", fillcolor="#e2f0d9"];
    ProductFrameRequest [label="{ProductFrameRequest|target FrameSpec; optional context}", fillcolor="#d9eaf7"];
    CoordinateService [label="{CoordinateService|sole validation and transformation owner}", fillcolor="#e2f0d9"];
    AstropyAdapter [label="AstropyAdapter", fillcolor="#e2f0d9"];
    SkyfieldAdapter [label="SkyfieldAdapter", fillcolor="#e2f0d9"];
    Transformer [label="AstronomicalTransformer «Protocol»", fillcolor="#ffffff"];
    ScientificIdentity -> FrameSpec [dir=both, arrowtail=diamond, arrowhead=none, label="contains"];
    AstronomicalState -> ScientificIdentity [dir=both, arrowtail=diamond, arrowhead=none, label="contains"];
    ProductFrameRequest -> FrameSpec [dir=both, arrowtail=diamond, arrowhead=none, label="contains"];
    ProductFrameRequest -> ObservationContext [dir=both, arrowtail=odiamond, arrowhead=none, label="optional"];
    CoordinateService -> AstropyAdapter [dir=both, arrowtail=diamond, arrowhead=none, label="owns"];
    CoordinateService -> SkyfieldAdapter [dir=both, arrowtail=diamond, arrowhead=none, label="owns"];
    CoordinateService -> Transformer [arrowhead=empty, style=dashed, label="implements"];
  }
  subgraph cluster_geometry {
    label="geometry/ — records retained, typed identity added";
    color="#548235"; style="rounded,dashed";
    Points [label="{SphericalPoints|lon/lat; ids; labels; ScientificIdentity}", fillcolor="#d9eaf7"];
    Curves [label="{SphericalCurves|collections; topology; ScientificIdentity}", fillcolor="#d9eaf7"];
    Polygons [label="{SphericalPolygons|rings; topology; ScientificIdentity}", fillcolor="#d9eaf7"];
    Grid [label="{SphericalGrid|mapping of typed SphericalCurves}", fillcolor="#d9eaf7"];
    SphericalCoordinates [label="{SphericalCoordinates|coordinate-neutral rotation result}", fillcolor="#e2f0d9"];
    SphericalFrame [label="{SphericalFrame|projection alignment only}", fillcolor="#e2f0d9"];
    Grid -> Curves [dir=both, arrowtail=diamond, arrowhead=none, label="contains"];
  }
  subgraph cluster_charts {
    label="charts/ — request frames; never transform";
    color="#2f75b5"; style="rounded,dashed";
    ProjectionSelection [label="{ProjectionSelection|projection identity; ProductFrameRequest}", fillcolor="#d9eaf7"];
    CoordinateFrames [shape=box, label="coordinate_frames.py\nremoved or delegates during migration", fillcolor="#fce4d6", color="#c55a11"];
    Owners [shape=box, label="chart + furniture owners\nconstruct ProductFrameRequest; do not transform", fillcolor="#d9eaf7"];
    Pipeline [shape=box, label="projection pipeline\nuses SphericalFrame; unchanged", fillcolor="#e2f0d9"];
  }
  Observer -> ObservationContext [style=dashed, label="constructs", color="#c55a11"];
  Coordinates -> CoordinateService [style=dashed, label="retires/delegates", color="#c55a11"];
  Cache -> AstronomicalState [style=dashed, label="keys"];
  Stars -> AstronomicalState [style=dashed, label="produces"];
  NonStellar -> AstronomicalState [style=dashed, label="produces"];
  CoordinatesGrid -> CoordinateService [style=dashed, label="requests transform"];
  CelestialPoints -> CoordinateService [style=dashed, label="requests transform"];
  AstronomicalState -> CoordinateService [style=dashed, label="typed input"];
  ProductFrameRequest -> CoordinateService [style=dashed, label="declares output"];
  CoordinateService -> Points [style=dashed, label="returns typed geometry"];
  CoordinateService -> Curves [style=dashed, label="preserves topology"];
  Owners -> ProductFrameRequest [style=dashed, label="declares"];
  ProjectionSelection -> ProductFrameRequest [style=dashed, label="contains"];
  CoordinateFrames -> CoordinateService [style=dashed, label="delegates during migration", color="#c55a11"];
  ProjectionSelection -> SphericalFrame [style=dashed, label="requests alignment"];
  SphericalFrame -> Pipeline [style=dashed, label="unchanged"];
}

