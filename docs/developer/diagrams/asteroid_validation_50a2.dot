digraph asteroid_validation_50a2 {
  graph [rankdir=LR, bgcolor="white", fontname="Helvetica", fontsize=15,
    label="Wenu 50A.2 — bounded asteroid numerical validation",
    labelloc="t", nodesep=0.4, ranksep=0.55, pad=0.25];
  node [shape=box, style="rounded,filled", fillcolor="#f7f7f7",
    color="#555555", fontname="Helvetica", fontsize=10,
    margin="0.13,0.09"];
  edge [color="#555555", fontname="Helvetica", fontsize=8,
    arrowsize=0.7];

  horizons [label="Frozen direct Horizons oracle\nstate + direction + parallax",
    fillcolor="#fff2cc"];
  spice [label="SpiceMinorBodyKernel\nexact type-21 descriptor",
    fillcolor="#fce4d6"];
  planet [label="DE440 / Skyfield\ncentre + observer + apparent",
    fillcolor="#fff2cc"];
  chain [label="SkyfieldMinorBodyStateSource\nexplicit BC + CO composition",
    fillcolor="#d9eaf7"];
  direction [label="Existing direction realizers\nlight time + apparent ICRS",
    fillcolor="#e2f0d9"];
  later [label="Body + chart + output\nnot connected in 50A.2",
    style="rounded,dashed,filled", fillcolor="#eeeeee"];

  spice -> chain [label="BC state + segment identity"];
  planet -> chain [label="CO state + dependency identity"];
  chain -> direction [label="resource-chain state"];
  planet -> direction [label="observer + corrections"];
  horizons -> direction [dir=both, arrowtail=none,
    label="independent comparison"];
  direction -> later [style=dashed, label="50A.3 only after acceptance"];
}
