digraph coordinate_static_v095 {
  graph [rankdir=LR, bgcolor="white", fontname="Helvetica", fontsize=17,
    label="Wenu v0.9.5 coordinate static structure — implemented classes, data, procedures, and ownership",
    labelloc="t", nodesep=0.42, ranksep=0.62, pad=0.35, size="30,18!"];
  node [shape=record, style="filled", fillcolor="#f7f7f7", color="#555555", fontname="Helvetica", fontsize=9];
  edge [color="#555555", fontname="Helvetica", fontsize=8, arrowsize=0.72];

  subgraph cluster_positions {
    label="src/wenu/positions.py + objects/ — native position providers"; color="#8064a2";
    PositionProvider [label="{PositionProvider «runtime Protocol»|position(instant=None) -> SphericalPoints|generates native positions; never projects}", fillcolor="#e4dfec"];
    Stars [label="{objects/stars.py::Stars|native ICRS catalogue position; separate Skyfield apparent realization|position(instant); spherical_geometry(observer, ...)}", fillcolor="#e4dfec"];
    NonStellar [label="{objects/nonstellar.py::NonStellar|native ICRS catalogue centres|position(instant); spherical_geometry(observer, ...)}", fillcolor="#e4dfec"];
    OpenClusters [label="{objects/open_clusters.py::OpenClusters|native ICRS catalogue centres|position(instant); spherical_geometry(observer, ...)}", fillcolor="#e4dfec"];
    Stars -> PositionProvider [arrowhead=empty, style=dashed, label="structurally implements"];
    NonStellar -> PositionProvider [arrowhead=empty, style=dashed, label="structurally implements"];
    OpenClusters -> PositionProvider [arrowhead=empty, style=dashed, label="structurally implements"];
  }

  subgraph cluster_layers {
    label="src/wenu/sky/ + objects/ — existing layer hierarchy and constructed references"; color="#8064a2";
    SkyLayer [label="{SkyLayer «ABC»|spherical_geometry(observer)}"];
    AstronomicalObject [label="AstronomicalObject"];
    GeometricalObject [label="GeometricalObject"];
    CoordinatesGrid [label="{CoordinatesGrid «ABC»|parallel(); meridian(); grid(); spherical_geometry()}"];
    AltAzGrid [label="AltAzGrid"]; EquatorialGrid [label="EquatorialGrid"];
    EclipticGrid [label="EclipticGrid"]; GalacticGrid [label="GalacticGrid"];
    CelestialPoints [label="{CelestialPoints|constructed poles and reference points|spherical_geometry()}"];
    CelestialSphere [label="{CelestialSphere|layers: tuple[SkyLayer]|add(); draw_chart()}"];
    AstronomicalObject -> SkyLayer [arrowhead=empty, label="inherits"];
    GeometricalObject -> SkyLayer [arrowhead=empty, label="inherits"];
    Stars -> AstronomicalObject [arrowhead=empty, label="inherits"];
    NonStellar -> AstronomicalObject [arrowhead=empty, label="inherits"];
    OpenClusters -> AstronomicalObject [arrowhead=empty, label="inherits"];
    CoordinatesGrid -> GeometricalObject [arrowhead=empty, label="inherits"];
    CelestialPoints -> GeometricalObject [arrowhead=empty, label="inherits"];
    AltAzGrid -> CoordinatesGrid [arrowhead=empty]; EquatorialGrid -> CoordinatesGrid [arrowhead=empty];
    EclipticGrid -> CoordinatesGrid [arrowhead=empty]; GalacticGrid -> CoordinatesGrid [arrowhead=empty];
    CelestialSphere -> SkyLayer [dir=both, arrowtail=diamond, arrowhead=none, label="contains 0..*"];
  }

  subgraph cluster_geometry {
    label="src/wenu/geometry/spherical.py — typed astronomical interchange geometry"; color="#70ad47";
    GeometryUnion [label="SphericalGeometry = Points | Curves | Polygons | Grid", fillcolor="#e2f0d9"];
    Points [label="{SphericalPoints «dataclass»|lon_deg; lat_deg; ids; labels; metadata|coordinate_spec: CoordinateSpec}", fillcolor="#e2f0d9"];
    Curves [label="{SphericalCurves «dataclass»|coordinate collections; topology; metadata|coordinate_spec: CoordinateSpec}", fillcolor="#e2f0d9"];
    Polygons [label="{SphericalPolygons «dataclass»|rings; topology; metadata|coordinate_spec: CoordinateSpec}", fillcolor="#e2f0d9"];
    Grid [label="{SphericalGrid «dataclass»|curves: mapping[str, SphericalCurves]|coordinate_spec: CoordinateSpec}", fillcolor="#e2f0d9"];
    GeometryUnion -> Points [arrowhead=empty, style=dashed]; GeometryUnion -> Curves [arrowhead=empty, style=dashed];
    GeometryUnion -> Polygons [arrowhead=empty, style=dashed]; GeometryUnion -> Grid [arrowhead=empty, style=dashed];
    Grid -> Curves [dir=both, arrowtail=diamond, arrowhead=none, label="contains"];
    PositionProvider -> Points [style=dashed, label="returns"];
    CoordinatesGrid -> Grid [style=dashed, label="constructs"];
    CelestialPoints -> Points [style=dashed, label="constructs"];
  }

  subgraph cluster_coordinates {
    label="src/wenu/coordinates.py + coordinate_service.py — single coordinate authority"; color="#548235";
    CoordinateSpec [label="{CoordinateSpec «frozen dataclass»|frame; origin; epoch/equinox; instant; time scale|position status; units/representation; provenance}", fillcolor="#e2f0d9"];
    ObservationContext [label="{ObservationContext «frozen dataclass»|location; instant; time scale|atmosphere/refraction and Earth-orientation policy}", fillcolor="#fff2cc"];
    CoordinateService [label="{CoordinateService|transform(geometry, target, observation=None) -> same kind|transform_observer_geometry(); transform_skycoord()|validates; builds Astropy frames; preserves topology/metadata}", fillcolor="#e2f0d9"];
    Observer [label="{observer.py::Observer|location; t_astropy; earth_location; altaz_frame|observation_context property}", fillcolor="#fce4d6"];
    Observer -> ObservationContext [style=dashed, label="constructs"];
    CoordinateService -> CoordinateSpec [dir=both, arrowtail=diamond, arrowhead=none, label="uses source + target"];
    CoordinateService -> ObservationContext [style=dashed, label="required for local path"];
    Points -> CoordinateSpec [style=dashed, label="carries"]; Curves -> CoordinateSpec [style=dashed, label="carries"];
    Polygons -> CoordinateSpec [style=dashed, label="carries"]; Grid -> CoordinateSpec [style=dashed, label="carries"];
    GeometryUnion -> CoordinateService [style=dashed, label="transform() input/output"];
  }

  subgraph cluster_downstream {
    label="src/wenu/charts/ + geometry/frame.py — coordinate-neutral consumers"; color="#5b9bd5";
    ProjectionSelection [label="{ProjectionSelection «frozen dataclass»|name; target_coordinate_spec: CoordinateSpec|build()}", fillcolor="#d9eaf7"];
    SphericalCoordinates [label="{SphericalCoordinates «frozen dataclass»|lon_deg; lat_deg}", fillcolor="#e2f0d9"];
    SphericalFrame [label="{SphericalFrame «frozen dataclass»|pole; position_angle; rotation_matrix|transform(); inverse_transform()|projection alignment only}", fillcolor="#e2f0d9"];
    Projection [label="{Projection|project(); domain guard|coordinate-neutral}", fillcolor="#d9eaf7"];
    Clipping [label="{Clipping + viewport|clip projected topology}", fillcolor="#d9eaf7"];
    Preparation [label="{Chart preparation|prepared graphical records}", fillcolor="#d9eaf7"];
    Renderer [label="{Renderer + furniture + export|output realization}", fillcolor="#d9eaf7"];
    ProjectionSelection -> CoordinateSpec [style=dashed, label="declares target"];
    CoordinateService -> SphericalFrame [style=dashed, label="resolved geometry"];
    ProjectionSelection -> SphericalFrame [style=dashed, label="alignment request"];
    SphericalFrame -> SphericalCoordinates [style=dashed, label="returns"];
    SphericalFrame -> Projection -> Clipping -> Preparation -> Renderer;
  }

  FutureProvider [shape=note, label="Extension point (not yet implemented)\nMoon, planet, comet, asteroid, or satellite support adds a PositionProvider.\nCoordinateService and downstream chart/rendering classes do not change.", fillcolor="#fff2cc", style="dashed,filled"];
  FutureProvider -> PositionProvider [arrowhead=empty, style=dashed, label="future implementation"];
}
