#   unit: mag
#   datatype: float64
#   format: '{:4.2f}'
#   description: Foreground Reddening
#   meta: !!omap
#   - {ucd: phot.color.excess}
#   - {width: 4}
#   - {precision: F2}
# - name: hb_vmag
#   unit: mag
#   datatype: float64
#   format: '{:5.2f}'
#   description: V Magnitude Level of the Horizontal Branch (or RR Lyraes)
#   meta: !!omap
#   - {ucd: phot.mag;em.opt.V}
#   - {width: 5}
#   - {precision: F2}
