#   datatype: string
#   description: Alternative Designation of Globular Cluster
#   meta: !!omap
#   - {ucd: meta.id}
#   - {_votable_string_dtype: char}
#   subtype: json
# - name: ra
#   unit: deg
#   datatype: float64
#   format: '{:.5f}'
#   description: Right Ascension
#   meta: !!omap
#   - {ucd: pos.eq.ra;meta.main}
#   - {precision: F5}
# - name: dec
#   unit: deg
#   datatype: float64
#   format: '{:.5f}'
#   description: Declination
#   meta: !!omap
#   - {ucd: pos.eq.dec;meta.main}
#   - {precision: F5}
# - name: lii
#   unit: deg
#   datatype: float64
#   format: '{:.5f}'
#   description: Galactic Longitude
#   meta: !!omap
#   - {ucd: pos.galactic.lon}
#   - {precision: F5}
# - name: bii
#   unit: deg
#   datatype: float64
#   format: '{:.5f}'
#   description: Galactic Latitude
#   meta: !!omap
#   - {ucd: pos.galactic.lat}
#   - {precision: F5}
# - name: helio_distance
#   unit: kpc
#   datatype: float64
#   format: '{:5.1f}'
#   description: Distance from the Sun
#   meta: !!omap
#   - {ucd: pos.distance}
#   - {width: 5}
#   - {precision: F1}
# - name: galcen_distance
#   unit: kpc
#   datatype: float64
#   format: '{:5.1f}'
#   description: Distance from the Center of the Milky Way Galaxy
#   meta: !!omap
#   - {ucd: pos.distance}
#   - {width: 5}
#   - {precision: F1}
# - name: x_distance
#   unit: kpc
#   datatype: float64
#   format: '{:5.1f}'
#   description: X Distance Component
#   meta: !!omap
#   - {ucd: pos.cartesian.x;pos.galactocentric}
#   - {width: 5}
#   - {precision: F1}
# - name: y_distance
#   unit: kpc
#   datatype: float64
#   format: '{:5.1f}'
#   description: Y Distance Component
#   meta: !!omap
#   - {ucd: pos.cartesian.y;pos.galactocentric}
#   - {width: 5}
#   - {precision: F1}
# - name: z_distance
#   unit: kpc
#   datatype: float64
#   format: '{:5.1f}'
#   description: Z Distance Component
#   meta: !!omap
#   - {ucd: pos.cartesian.z;pos.galactocentric}
#   - {width: 5}
#   - {precision: F1}
# - name: metallicity
#   datatype: float64
#   format: '{:5.2f}'
#   description: 'Metallicity: Fe/H'
#   meta: !!omap
#   - {ucd: phys.abund.Fe}
#   - {width: 5}
#   - {precision: F2}
# - name: num_metallicity_measures
#   datatype: int16
#   description: Number of Measurements Used to Determine Mean Metallicity
#   meta: !!omap
#   - {ucd: meta.number}
#   - {width: 2}
#   - values: {'null': -32768}
