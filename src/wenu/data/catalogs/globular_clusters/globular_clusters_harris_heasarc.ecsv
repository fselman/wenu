#   datatype: float64
#   format: '{:6.2f}'
#   description: Absolute Visual Magnitude (Cluster Luminosity)
#   meta: !!omap
#   - {ucd: phys.magAbs;em.opt.V}
#   - {width: 6}
#   - {precision: F2}
