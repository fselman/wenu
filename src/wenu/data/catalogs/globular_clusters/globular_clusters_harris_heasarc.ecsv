#   unit: mag
#   datatype: float64
#   format: '{:5.2f}'
#   description: Apparent Visual Distance Modulus
#   meta: !!omap
#   - {ucd: phot.mag.distMod}
#   - {width: 5}
#   - {precision: F2}
# - name: vmag
#   unit: mag
#   datatype: float64
#   format: '{:5.2f}'
#   description: Integrated V Magnitude of the Cluster
#   meta: !!omap
#   - {ucd: phot.mag;em.opt.V}
#   - {width: 5}
#   - {precision: F2}
